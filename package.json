{
  "name": "alpha-life-engine",
  "version": "1.0.0",
  "description": "Alpha-Life Engine - Personal Quantitative DCA System",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "backend:dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "preview": "vite preview",
    "database:migrate": "tsx scripts/run-migrations.ts",
    "database:migrate:prod": "tsx scripts/run-migrations.ts --prod",
    "market:setup": "tsx scripts/market-setup.ts",
    "market:init": "npm run market:setup && npm run database:migrate && npm run database:import-market",
    "market:init:prod": "npm run market:setup && npm run database:migrate:prod && npm run database:import-market:prod",
    "symbols:sync": "tsx scripts/gen-python-symbols.ts",
    "market:update": "tsx scripts/daily-market-update.ts",
    "database:import-market": "wrangler d1 execute alpha-life-dev --file=./data/market_data/import_market_data.sql --local",
    "database:import-market:prod": "wrangler d1 execute alpha-life-prod --file=./data/market_data/import_market_data.sql --remote",
    "market:update:prod": "tsx scripts/daily-market-update.ts --prod",
    "backfill:realized": "tsx scripts/backfill-realized-pnl.ts",
    "backfill:realized:prod": "tsx scripts/backfill-realized-pnl.ts --prod",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:python": "ruff check scripts/local_evolver/ data/",
    "lint:python:fix": "ruff check --fix scripts/local_evolver/ data/",
    "format:python": "ruff format --check scripts/local_evolver/ data/",
    "format:python:fix": "ruff format scripts/local_evolver/ data/",
    "typecheck:python": "mypy --strict --explicit-package-bases scripts/local_evolver/ data/",
    "security:python": "bandit -r scripts/local_evolver/ data/ -c pyproject.toml",
    "lint:python:all": "npm run lint:python && npm run format:python && npm run typecheck:python && npm run security:python",
    "evolve": "python scripts/local_evolver/evolver.py"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "hono": "^4.13.2",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@*": true,
    "sharp@*": true,
    "workerd@*": true
  }
}
